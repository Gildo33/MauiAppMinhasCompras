<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Entry x:Name="txt_descricao" Placeholder="Descrição do Produto" />
        <Entry x:Name="txt_quantidade" Placeholder="Quantidade" Keyboard="Numeric" />
        <Entry x:Name="txt_preco" Placeholder="Preço Unitário" Keyboard="Numeric" />
        <Label Text="Categoria:" FontSize="16" />
        <Picker x:Name="pck_categoria" Title="Selecione a Categoria">
            <Picker.Items>
                <x:String>Alimentos</x:String>
                <x:String>Higiene</x:String>
                <x:String>Limpeza</x:String>
                <x:String>Outros</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Salvar Produto" Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>